# Postgres with PostGIS enabled (CREATE EXTENSION postgis;)
DATABASE_URL="postgresql://user:pass@localhost:5432/findworkers"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Seeded admin (dev only). Password must be 12+ characters.
SEED_ADMIN_EMAIL="admin@findworkers.local"
SEED_ADMIN_PASSWORD=""

# Document storage. "local" writes to .private-uploads/ and is refused in production.
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Search map uses Leaflet + OpenStreetMap (self-hosted in public/vendor, no key needed).
# MAP_PROVIDER / MAPBOX_TOKEN are unused for now.
# Not connected yet. Leave empty; features report "not configured".
MAP_PROVIDER=""
MAPBOX_TOKEN=""
# Phone verification by SMS. Set SMS_PROVIDER="termii" plus the three TERMII_ values (from the Termii dashboard).
# TERMII_SENDER_ID must be a sender ID Termii has approved for you (3-11 characters, e.g. "FindWorkers").
# TERMII_BASE_URL is shown on your Termii dashboard; leave empty to use https://api.ng.termii.com.
# Without these, development prints codes to the server log and production hides the "Verify" button.
SMS_PROVIDER=""
TERMII_API_KEY=""
TERMII_SENDER_ID=""
TERMII_BASE_URL=""
EMAIL_PROVIDER=""
RESEND_API_KEY=""
IDENTITY_PROVIDER="manual"
NEXT_PUBLIC_BACKGROUND_CHECKS="false"

# Paystack (Pro plan payments). Secret key from Paystack → Settings → API Keys & Webhooks.
# Use sk_test_... until you're ready to take real money. Leave empty to show "Payments aren't set up yet".
PAYSTACK_SECRET_KEY=""
