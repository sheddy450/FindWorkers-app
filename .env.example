# Postgres with PostGIS enabled (CREATE EXTENSION postgis;)
DATABASE_URL="postgresql://user:pass@localhost:5432/findworkers"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Seeded admin (dev only). Password must be 12+ characters.
SEED_ADMIN_EMAIL="admin@findworkers.local"
SEED_ADMIN_PASSWORD=""

# Document storage. "local" writes to .private-uploads/ and is refused in production.
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Search map uses Leaflet + OpenStreetMap (self-hosted in public/vendor, no key needed).
# MAP_PROVIDER / MAPBOX_TOKEN are unused for now.
# Not connected yet. Leave empty; features report "not configured".
MAP_PROVIDER=""
MAPBOX_TOKEN=""
SMS_PROVIDER=""
TERMII_API_KEY=""
EMAIL_PROVIDER=""
RESEND_API_KEY=""
IDENTITY_PROVIDER="manual"
NEXT_PUBLIC_BACKGROUND_CHECKS="false"

# Paystack (Pro plan payments). Secret key from Paystack → Settings → API Keys & Webhooks.
# Use sk_test_... until you're ready to take real money. Leave empty to show "Payments aren't set up yet".
PAYSTACK_SECRET_KEY=""

# Password reset emails. Set EMAIL_PROVIDER="resend" and RESEND_API_KEY (above), plus EMAIL_FROM using a domain
# verified in Resend, e.g. EMAIL_FROM="FindWorkers <no-reply@findworkersapp.com>". Without them, development
# prints emails to the server log; production can't send reset links.
EMAIL_FROM=""

# Meta (Facebook/Instagram) ads tracking. Leave empty to turn it off completely (no cookie banner either).
# Pixel/dataset ID from Events Manager. Loaded only after the visitor taps "Accept" on the cookie banner.
NEXT_PUBLIC_META_PIXEL_ID=""
# Events Manager → your dataset → Settings → Conversions API → "Generate access token". Server-side only.
META_CAPI_ACCESS_TOKEN=""
# Only while testing: the code from Events Manager → Test events. Remove it afterwards.
META_TEST_EVENT_CODE=""
# Meta Business Suite → Brand safety → Domains → Meta-tag verification: the content="..." value.
META_DOMAIN_VERIFICATION=""
